<?xml version="1.0"?>
<ruleset name="MyProject">
    <description>Custom PSR-12 with custom line length</description>

    <!-- Подключаем стандарт PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Переопределяем лимит длины строки -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <!-- Предупреждение, если строка длиннее 160 символов -->
            <property name="lineLimit" value="160"/>
            <!-- Ошибка, если строка длиннее 200 символов -->
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>

    <!-- Директории для проверки -->
    <file>app</file>
    <file>routes</file>

    <!-- Игнорируем служебные директории -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
</ruleset>