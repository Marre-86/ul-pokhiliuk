{
    "openapi": "3.0.0",
    "info": {
        "title": "[Похилюк Артем] Тестовое задание для ООО «Умная Логистика»",
        "description": "Сервисная документация",
        "contact": {
            "email": "artempokhiliuk@yahoo.com"
        },
        "license": {
